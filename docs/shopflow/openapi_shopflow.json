  "components": {
    "schemas": {
      "CouponApply": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CouponApply"
      },
      "CouponCreate": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "percent": {
            "type": "integer",
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Percent"
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Uses",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "code",
          "percent"
        ],
        "title": "CouponCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginReq": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginReq"
      },
      "OrderCreate": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "OrderCreate"
      },
      "OrderItem": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "qty": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Qty"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "qty"
        ],
        "title": "OrderItem"
      },
      "OrderPatch": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          }
        },
        "type": "object",
        "title": "OrderPatch"
      },
      "ProductCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          },
          "cost_price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cost Price",
            "default": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "title": "ProductCreate"
      },
      "ProductPatch": {
        "properties": {
          "price": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "stock": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stock"
          }
        },
        "type": "object",
        "title": "ProductPatch"
      },
      "RefundCreate": {
        "properties": {
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "RefundCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
