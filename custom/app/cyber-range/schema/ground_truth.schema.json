{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/cyber-range/ground_truth.schema.json",
  "title": "Cyber Range Ground Truth CSV row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "app",
    "family",
    "scenario",
    "operation_id",
    "method",
    "path",
    "attacker",
    "victim",
    "object_id",
    "oracle_type",
    "expected_safe",
    "observed_vulnerable",
    "flag",
    "is_benign",
    "cwe",
    "owasp",
    "severity",
    "split",
    "evidence_required",
    "verification_status",
    "verified_by",
    "verified_at",
    "setup_steps",
    "request_headers",
    "request_body"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(AUTHZ-[0-9]{3}|AUTHZ-(INV|PAY|TCK|REV)-[0-9]{2}|BENIGN-[0-9]{3})$"
    },
    "app": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "enum": [
        "BOLA",
        "BFLA",
        "BOPLA",
        "TENANT",
        "WORKFLOW"
      ]
    },
    "scenario": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "attacker": {
      "type": "string"
    },
    "victim": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "oracle_type": {
      "type": "string",
      "enum": [
        "differential_authz",
        "role_matrix",
        "property_diff",
        "state_invariant",
        "benign_behavior"
      ]
    },
    "expected_safe": {
      "type": "string"
    },
    "observed_vulnerable": {
      "type": "string"
    },
    "flag": {
      "type": "string"
    },
    "is_benign": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    },
    "cwe": {
      "type": "string"
    },
    "owasp": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held-out"
      ]
    },
    "evidence_required": {
      "type": "string",
      "description": "JSON-encoded array of evidence requirements in the CSV cell."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending-human-review",
        "fixture"
      ]
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "description": "Empty string until human verification."
    },
    "setup_steps": {
      "type": "string",
      "description": "JSON-encoded ordered array of fixture/setup HTTP requests required before this case."
    },
    "request_headers": {
      "type": "string",
      "description": "JSON-encoded headers required on the probe (for example x-lab-case-id)."
    },
    "request_body": {
      "type": "string",
      "description": "JSON-encoded request body; use {} when no body is required."
    }
  }
}
