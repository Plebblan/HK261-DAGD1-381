      "execution_mode": "autonomous",
      "risk_tier": "write",
      "auth_required": false,
      "required_roles": [],
      "synthetic_data_only": true,
      "rate_limit_per_minute": 60,
      "notes": "In scope for traces and planner use. Allowlisted means in scope, not a vulnerability verdict."
