{
  "version": "1.0",
  "purpose": "Safety allowlist for the local custom_1 shopflow range app.",
  "target": {
    "scheme": "http",
    "host": "localhost",
    "port": 8002,
    "base_url": "http://localhost:8002"
  },
  "default_deny": true,
  "allow_external_hosts": false,
  "require_safety_gateway": true,
  "require_synthetic_accounts_and_data": true,
  "redact_headers": [
    "authorization",
    "cookie",
    "set-cookie",
    "x-lab-key"
  ],
  "redact_json_fields": [
    "password",
    "token",
    "api_key",
    "secret"
  ],
  "global_limits": {
    "max_concurrency": 1,
    "timeout_seconds": 10,
    "max_requests_per_run": 60
  },
  "explicit_denies": [
    {
      "method": "*",
      "path": "/docs*",
      "host": "localhost:8002",
      "reason": "Interactive docs are not test traffic."
    },
    {
      "method": "*",
      "path": "/redoc*",
      "host": "localhost:8002",
      "reason": "Documentation UI is not test traffic."
    },
    {
      "method": "*",
      "path": "/openapi.json",
      "host": "localhost:8002",
      "reason": "Contract metadata is not business traffic."
    }
  ],
  "runtrace_rules": [
    "Match the exact HTTP method and normalized path template; no prefix-only matching.",
    "Only use the synthetic actors in model/rso_custom.yaml; resolve path IDs from the seed or a recorded create response.",
    "Delete and reset operations require explicit approval (X-Range-Approval) and disposable data.",
    "Never store bearer tokens or passwords; the gateway redacts them in the event log.",
    "A request being allowlisted means it is in scope, not that its response is a vulnerability verdict."
  ],
  "entries": [
    {
      "id": "shopflow_login",
      "method": "POST",
      "path": "/auth/login",
      "host": "localhost:8002",
      "allow": true,
      "traffic_class": "positive_baseline",
      "execution_mode": "autonomous",
      "risk_tier": "write",
      "auth_required": false,
      "required_roles": [],
      "synthetic_data_only": true,
      "rate_limit_per_minute": 60,
      "notes": "In scope for traces and planner use. Allowlisted means in scope, not a vulnerability verdict."
    },
    {
