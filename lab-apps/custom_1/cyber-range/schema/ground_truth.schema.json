{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/cyber-range/ground_truth.schema.json",
  "title": "Cyber Range Ground Truth CSV row (taxonomy-aligned, derived from ground_truth.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "app",
    "family",
    "subtype",
    "secondary_families",
    "scenario",
    "operation_id",
    "method",
    "path",
    "attacker",
    "victim",
    "object_id",
    "oracle_type",
    "expected_safe",
    "expected_safe_status",
    "observed_vulnerable",
    "flag",
    "is_benign",
    "cwe",
    "owasp",
    "severity",
    "split",
    "evidence_required",
    "policy_ref",
    "invariant_id",
    "transition_ref",
    "verification_status",
    "verified_by",
    "verified_at",
    "setup_steps",
    "request_headers",
    "request_body",
    "trace_ref"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(AUTHZ-[0-9]{3}|BENIGN-[0-9]{3})$"
    },
    "app": {
      "type": "string",
      "enum": [
        "tenantdesk",
        "shopflow"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5"
      ],
      "description": "Primary family from docs/Taxonomy/families.yaml (D1)."
    },
    "subtype": {
      "type": "string",
      "enum": [
        "",
        "R",
        "W"
      ],
      "description": "F3 only: R = excessive data exposure, W = mass assignment."
    },
    "secondary_families": {
      "type": "string",
      "description": "JSON-encoded array of family ids."
    },
    "oracle_type": {
      "type": "string",
      "enum": [
        "differential_authorization",
        "property_policy_diff",
        "state_invariant",
        "benign_behavior"
      ]
    },
    "expected_safe_status": {
      "type": "string",
      "description": "JSON-encoded array of HTTP statuses that count as safe (D3)."
    },
    "is_benign": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held-out"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending-human-review",
        "fixture"
      ]
    },
    "evidence_required": {
      "type": "string",
      "description": "JSON-encoded array."
    },
    "setup_steps": {
      "type": "string",
      "description": "JSON-encoded ordered array of setup requests."
    },
    "request_headers": {
      "type": "string",
      "description": "JSON-encoded object."
    },
    "request_body": {
      "type": "string",
      "description": "JSON-encoded object ({} when none)."
    },
    "policy_ref": {
      "type": "string",
      "description": "Access-policy rule key (METHOD path) in access_policy_custom.yaml."
    },
    "invariant_id": {
      "type": "string",
      "description": "State-graph invariant violated (F5 and F5-secondary cases)."
    },
    "transition_ref": {
      "type": "string",
      "description": "State-graph transition involved, when one exists."
    },
    "trace_ref": {
      "type": "string",
      "description": "Valid-sequence trace (cyber-range/traces/<id>.json) that probes this case."
    },
    "scenario": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "attacker": {
      "type": "string"
    },
    "victim": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "expected_safe": {
      "type": "string"
    },
    "observed_vulnerable": {
      "type": "string"
    },
    "flag": {
      "type": "string"
    },
    "cwe": {
      "type": "string"
    },
    "owasp": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    }
  }
}
