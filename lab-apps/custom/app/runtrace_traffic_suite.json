            "sequence": 3,
            "screen": "Orders",
            "action": "Open order details",
            "operation_id": "lab_get_resource",
            "object_id": "order-a-001"
          }
        },
        {
          "id": "order_request_return",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "POST",
          "path": "/lab/v1/resources/order-a-001/actions/request_return",
          "interaction": {
            "sequence": 4,
            "screen": "Order details",
            "action": "Request a return",
            "operation_id": "lab_transition",
            "object_id": "order-a-001"
          }
        },
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a",
          "interaction": {
            "sequence": 5,
            "screen": "Sign in",
            "action": "Sign in as approver",
            "operation_id": "lab_issue_token"
          }
        },
        {
          "id": "order_approve_refund",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/resources/order-a-001/actions/approve_refund",
          "interaction": {
            "sequence": 6,
            "screen": "Refund approvals",
            "action": "Approve refund",
            "operation_id": "lab_transition",
            "object_id": "order-a-001"
          }
        },
        {
