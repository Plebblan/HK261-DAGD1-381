          "object_id": "order-a-001"
        },
        {
          "sequence": 7,
          "actor": "actor-admin-a",
          "screen": "Order details",
          "action": "View activity",
          "operation_id": "unmapped",
          "object_id": "order-a-001"
        }
      ],
      "steps": [
        {
          "id": "login_customer_a",
          "dsl": "login",
          "actor": "actor-customer-a",
