{
  "version": 2,
  "description": "Workflow-derived RunTrace traffic with runtime HTTP/state assertions. Execute stateful scenarios only after clean reset/reseed. Read-only authorization probes can be run independently.",
  "target": "http://localhost:8000",
  "scenarios": [
    {
      "id": "workflow-order-refund",
      "name": "Order refund lifecycle",
      "reset_required": true,
      "steps": [
        {
          "id": "login_customer_a",
          "dsl": "login",
          "actor": "actor-customer-a"
        },
        {
          "id": "order_read_before",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/order-a-001",
          "expect_status": 200,
          "expect_state": "delivered"
        },
        {
          "id": "order_request_return",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "POST",
          "path": "/lab/v1/resources/order-a-001/actions/request_return",
          "expect_status": 200,
          "expect_state": "return_pending"
        },
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a"
        },
        {
          "id": "order_approve_refund",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/resources/order-a-001/actions/approve_refund",
          "expect_status": 200,
          "expect_state": "returned"
        },
        {
          "id": "order_history",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/resources/order-a-001/history"
        }
      ]
    },
    {
      "id": "workflow-ticket",
      "name": "Support ticket lifecycle",
      "reset_required": true,
      "steps": [
        {
          "id": "login_customer_a",
          "dsl": "login",
          "actor": "actor-customer-a"
        },
        {
          "id": "ticket_read_before",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/ticket-a-001",
          "expect_status": 200,
          "expect_state": "open"
        },
        {
          "id": "login_support_a",
          "dsl": "login",
          "actor": "actor-support-a"
        },
        {
          "id": "ticket_assign",
          "dsl": "request",
          "actor": "actor-support-a",
          "method": "POST",
          "path": "/lab/v1/resources/ticket-a-001/actions/assign",
          "expect_status": 200,
          "expect_state": "assigned"
        },
        {
          "id": "ticket_close",
          "dsl": "request",
          "actor": "actor-support-a",
          "method": "POST",
          "path": "/lab/v1/resources/ticket-a-001/actions/close",
          "expect_status": 200,
          "expect_state": "closed"
        },
        {
          "id": "ticket_read_after",
          "dsl": "request",
          "actor": "actor-support-a",
          "method": "GET",
          "path": "/lab/v1/resources/ticket-a-001",
          "expect_status": 200,
          "expect_state": "closed"
        }
      ]
    },
    {
      "id": "workflow-invoice-payment",
      "name": "Seeded invoice submission and payment",
      "reset_required": true,
      "steps": [
        {
          "id": "login_supplier_a",
          "dsl": "login",
          "actor": "actor-supplier-a"
        },
        {
          "id": "invoice_read_before",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/invoices/invoice-a-001",
          "expect_status": 200,
          "expect_state": "draft"
        },
        {
          "id": "invoice_submit",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "POST",
          "path": "/lab/v1/invoices/invoice-a-001/submit",
          "expect_status": 200,
          "expect_state": "submitted"
        },
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a"
        },
        {
          "id": "invoice_approve",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/invoices/invoice-a-001/approve",
          "expect_status": 200,
          "expect_state": "approved"
        },
        {
          "id": "invoice_pay",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/invoices/invoice-a-001/pay",
          "expect_status": 200,
          "expect_state": "paid"
        },
        {
          "id": "invoice_history",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/invoices/invoice-a-001/history"
        }
      ]
    },
    {
      "id": "workflow-payout-release",
      "name": "Payout approval and release",
      "reset_required": true,
      "steps": [
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a"
        },
        {
          "id": "payout_read_before",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/payouts/payout-a-001",
          "expect_status": 200,
          "expect_state": "pending"
        },
        {
          "id": "payout_approve",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/payouts/payout-a-001/approve",
          "expect_status": 200,
          "expect_state": "approved"
        },
        {
          "id": "payout_release",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/payouts/payout-a-001/release",
          "expect_status": 200,
          "expect_state": "released"
        },
        {
          "id": "payout_history",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/payouts/payout-a-001/history"
        }
      ]
    },
    {
      "id": "workflow-ticket-escalation",
      "name": "Assigned ticket escalation and resolution",
      "reset_required": true,
      "steps": [
        {
          "id": "login_support_a",
          "dsl": "login",
          "actor": "actor-support-a"
        },
        {
          "id": "ticket_assign",
          "dsl": "request",
          "actor": "actor-support-a",
          "method": "POST",
          "path": "/lab/v1/resources/ticket-a-001/actions/assign",
          "expect_status": 200,
          "expect_state": "assigned"
        },
        {
          "id": "ticket_escalate",
          "dsl": "request",
          "actor": "actor-support-a",
          "method": "POST",
          "path": "/lab/v1/tickets/ticket-a-001/escalate",
          "expect_status": 200,
          "expect_state": "escalated"
        },
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a"
        },
        {
          "id": "ticket_resolve",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "POST",
          "path": "/lab/v1/tickets/ticket-a-001/resolve",
          "expect_status": 200,
          "expect_state": "resolved"
        },
        {
          "id": "ticket_read_after",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/resources/ticket-a-001",
          "expect_status": 200,
          "expect_state": "resolved"
        }
      ]
    },
    {
      "id": "authorization-read-probes",
      "name": "Read-only ownership and tenant probes",
      "reset_required": false,
      "steps": [
        {
          "id": "login_customer_a",
          "dsl": "login",
          "actor": "actor-customer-a"
        },
        {
          "id": "customer_a_list_orders",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources",
          "params": {
            "resource_type": "order"
          }
        },
        {
          "id": "customer_a_read_own",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/order-a-001",
          "expect_status": 200,
          "expect_state": "delivered"
        },
        {
          "id": "customer_a_read_peer_tenant",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/order-b-001",
          "expect_status": 403
        },
        {
          "id": "login_customer_b",
          "dsl": "login",
          "actor": "actor-customer-b"
        },
        {
          "id": "customer_b_read_own",
          "dsl": "request",
          "actor": "actor-customer-b",
          "method": "GET",
          "path": "/lab/v1/resources/order-b-001",
          "expect_status": 200,
          "expect_state": "created"
        },
        {
          "id": "customer_b_read_other_tenant",
          "dsl": "request",
          "actor": "actor-customer-b",
          "method": "GET",
          "path": "/lab/v1/resources/order-a-001",
          "expect_status": 403
        },
        {
          "id": "login_supplier_a",
          "dsl": "login",
          "actor": "actor-supplier-a"
        },
        {
          "id": "supplier_list_invoices",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/invoices"
        },
        {
          "id": "supplier_read_invoice_a",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/invoices/invoice-a-001",
          "expect_status": 200,
          "expect_state": "draft"
        },
        {
          "id": "login_admin",
          "dsl": "login",
          "actor": "actor-admin-a"
        },
        {
          "id": "admin_list_payouts",
          "dsl": "request",
          "actor": "actor-admin-a",
          "method": "GET",
          "path": "/lab/v1/payouts"
        },
        {
          "id": "customer_a_read_same_tenant_other_owner",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/doc-a-002",
          "expect_status": 403
        },
        {
          "id": "login_supplier_b",
          "dsl": "login",
          "actor": "actor-supplier-b"
        },
        {
          "id": "supplier_b_read_invoice_b",
          "dsl": "request",
          "actor": "actor-supplier-b",
          "method": "GET",
          "path": "/lab/v1/invoices/invoice-b-001",
          "expect_status": 200,
          "expect_state": "approved"
        },
        {
          "id": "supplier_a_read_invoice_b_cross_tenant",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/invoices/invoice-b-001",
          "expect_status": 403
        },
        {
          "id": "supplier_a_read_payout_a",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/payouts/payout-a-001",
          "expect_status": 200,
          "expect_state": "pending"
        },
        {
          "id": "supplier_a_read_payout_b_cross_tenant",
          "dsl": "request",
          "actor": "actor-supplier-a",
          "method": "GET",
          "path": "/lab/v1/payouts/payout-b-001",
          "expect_status": 403
        }
      ]
    }
  ]
}
