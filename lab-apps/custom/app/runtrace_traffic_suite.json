            "screen": "Sign in",
            "action": "Sign in",
            "operation_id": "lab_issue_token"
          }
        },
        {
          "id": "order_list",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources",
          "params": {
            "resource_type": "order"
          },
          "interaction": {
            "sequence": 2,
            "screen": "Orders",
            "action": "Load orders",
            "operation_id": "lab_list_resources"
          }
        },
        {
          "id": "order_read_before",
          "dsl": "request",
          "actor": "actor-customer-a",
          "method": "GET",
          "path": "/lab/v1/resources/order-a-001",
